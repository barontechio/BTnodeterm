{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Path values are relative to this file's own directory, so no "baseUrl" is
    // needed to anchor them. TypeScript 7 drops "baseUrl" entirely; this form
    // resolves identically on 5.x and 7.x.
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/core/relay/bytes.ts",
    "src/core/relay/e2ee.ts",
    "src/core/relay/relay-id.ts",
    "src/core/relay/join-code.ts",
    "src/core/relay/join-token.ts",
    "src/core/relay/relay-client.ts",
    "src/core/relay/relay-socket.ts",
    "src/core/relay/relay-trust.ts",
    "src/core/relay/mutual-approval-core.ts",
    "src/core/relay/approved-devices-core.ts",
    "src/core/relay/framing.ts",
    "src/core/relay/browser-transport.ts",

    "src/shared/**/*",
    "src/preload/index.d.ts"
  ]
}
